{
  "id": "horizontal-scroll",
  "name": "Horizontal Scroll",
  "version": "1.2.0",
  "manifestURI": "https://raw.githubusercontent.com/7r3e/seanime-extension/refs/heads/main/src/horizontal-scroll/manifest.json",
  "language": "typescript",
  "type": "plugin",
  "description": "Enables horizontal scrolling on the carousel element.",
  "author": "7r3e",
  "icon": "https://raw.githubusercontent.com/7r3e/seanime-extension/refs/heads/main/src/horizontal-scroll/icon.ico",
  "website": "",
  "lang": "multi",
  "payloadURI": "https://raw.githubusercontent.com/7r3e/seanime-extension/refs/heads/main/src/horizontal-scroll/main.ts",
  "plugin": {
    "version": "1",
    "permissions": {
      "scopes": [],
      "allow": {
        "unsafeFlags": [
          {
            "flag": "dom-script-manipulation",
            "reason": "For external script injection."
          }
        ]
      }
    }
  },
  "userConfig": {
    "requiresConfig": false,
    "version": 1,
    "fields": [
      {
        "name": "requireShift",
        "label": "Require shift key to scroll (restart Seanime to apply)",
        "type": "switch",
        "default": "false"
      },
      {
        "name": "speed",
        "label": "Scroll interval delay in ms (restart Seanime to apply)",
        "type": "select",
        "default": "120",
        "options": [
          {
            "label": "0",
            "value": "0"
          },
          {
            "label": "60",
            "value": "60"
          },
          {
            "label": "90",
            "value": "90"
          },
          {
            "label": "120",
            "value": "120"
          },
          {
            "label": "150",
            "value": "150"
          },
          {
            "label": "180",
            "value": "180"
          }
        ]
      }
    ]
  },
  "isDevelopment": false
}