{
  "id": "friend-stats",
  "name": "Friend stats",
  "version": "1.2.0",
  "manifestURI": "https://raw.githubusercontent.com/Kaktusmann/seanime-extension/refs/heads/main/src/friend-stats/manifest.json",
  "language": "typescript",
  "type": "plugin",
  "description": "Shows which of your followed AniList users are watching or have rated the anime you're viewing",
  "author": "Kaktus",
  "icon": "https://raw.githubusercontent.com/Kaktusmann/seanime-extension/refs/heads/main/src/friend-stats/icon.ico",
  "website": "",
  "lang": "multi",
  "payloadURI": "https://raw.githubusercontent.com/Kaktusmann/seanime-extension/refs/heads/main/src/friend-stats/main.ts",
  "plugin": {
    "version": "1",
    "permissions": {
      "scopes": ["anilist", "database", "anilist-token", "system"],
      "allow": {
        "commandScopes": [
          {
            "command": "cmd",
            "args": [
              { "value": "/c" },
              { "value": "start" },
              { "validator": "^https://anilist\\.co/user/.*$" }
            ]
          },
          {
            "command": "open",
            "args": [
              { "validator": "^https://anilist\\.co/user/.*$" }
            ]
          },
          {
            "command": "xdg-open",
            "args": [
              { "validator": "^https://anilist\\.co/user/.*$" }
            ]
          }
        ]
      }
    }
  },
  "isDevelopment": false
}