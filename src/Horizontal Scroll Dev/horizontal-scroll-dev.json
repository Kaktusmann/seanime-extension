{
  "id": "horizontal-scroll-dev",
  "name": "Horizontal Scroll Dev",
  "version": "1.0.0",
  "manifestURI": "",
  "language": "typescript",
  "type": "plugin",
  "description": "An example plugin",
  "author": "7r3e",
  "icon": "",
  "website": "",
  "lang": "multi",
  "payloadURI": "E:\\Arbeit\\SeanimeDev\\seanime-extension\\src\\horizontal-scroll-dev\\Horizontal Scroll Dev\\provider.ts",
  "plugin": {
    "version": "1",
    "permissions": {
      "scopes": []
    }
  },
  "userConfig": {
    "requiresConfig": false,
    "version": 1,
    "fields": [
      {
        "name": "requireShift",
        "label": "Require shift key to scroll (restart Seanime to apply)",
        "type": "switch",
        "default": "false"
      },
      {
        "name": "speed",
        "label": "Scroll interval delay in ms (restart Seanime to apply)",
        "type": "select",
        "default": "120",
        "options": [
          {
            "label": "0",
            "value": "0"
          },
          {
            "label": "60",
            "value": "60"
          },
          {
            "label": "90",
            "value": "90"
          },
          {
            "label": "120",
            "value": "120"
          },
          {
            "label": "150",
            "value": "150"
          },
          {
            "label": "180",
            "value": "180"
          }
        ]
      }
    ]
  },
  "isDevelopment": true
}