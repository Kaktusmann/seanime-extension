{
  "id": "animethemes-new",
  "name": "AnimeThemes Player",
  "version": "2.1.0",
  "manifestURI": "https://raw.githubusercontent.com/Kaktusmann/seanime-extension/refs/heads/main/src/animethemes-new/manifest.json",
  "language": "typescript",
  "type": "plugin",
  "description": "Displays an animes openings and endings (using animethemes.moe) directly on its page.",
  "author": "jabifx & Kaktus",
  "icon": "https://raw.githubusercontent.com/Kaktusmann/seanime-extension/refs/heads/main/src/animethemes-new/icon.ico",
  "website": "",
  "lang": "multi",
  "payloadURI": "https://raw.githubusercontent.com/Kaktusmann/seanime-extension/refs/heads/main/src/animethemes-new/main.ts",
  "plugin": {
    "version": "1",
    "permissions": {
      "scopes": ["storage"],
      "allow": {
        "unsafeFlags": [{"flag": "dom-script-manipulation", "reason": "required for the plugin to modify app UI"}]
      }
    }
  },
  "isDevelopment": false
}