{
  "id": "animethemes-new",
  "name": "AnimeThemes Player (NEW)",
  "version": "2.2.1",
  "manifestURI": "https://raw.githubusercontent.com/Kaktusmann/seanime-extension/refs/heads/main/src/animethemes-new/manifest.json",
  "language": "typescript",
  "type": "plugin",
  "description": "Displays an animes openings and endings (using animethemes.moe) directly on its page.",
  "author": "jabifx & Kaktus",
  "icon": "https://raw.githubusercontent.com/Kaktusmann/seanime-extension/refs/heads/main/src/animethemes-new/icon.ico",
  "website": "",
  "lang": "multi",
  "payloadURI": "https://raw.githubusercontent.com/Kaktusmann/seanime-extension/refs/heads/main/src/animethemes-new/main.ts",
  "plugin": {
    "version": "1",
    "permissions": {
      "scopes": ["storage", "anilist"],
      "allow": {
        "unsafeFlags": [{"flag": "dom-script-manipulation", "reason": "required for the plugin to modify app UI"}]
      }
    }
  },
  "userConfig": {
    "requiresConfig": false,
    "version": 1,
    "fields": [
      {
        "name": "defaultProvider",
        "label": "Default provider",
        "type": "select",
        "default": "animethemes",
        "options": [
          { "label": "AnimeThemes", "value": "animethemes" },
          { "label": "AniSongDB", "value": "anisongdb" }
        ]
      },
      {
        "name": "initialVolume",
        "label": "Initial volume",
        "type": "select",
        "default": "0.7",
        "options": [
          { "label": "0%", "value": "0" },
          { "label": "25%", "value": "0.25" },
          { "label": "50%", "value": "0.5" },
          { "label": "70%", "value": "0.7" },
          { "label": "75%", "value": "0.75" },
          { "label": "100%", "value": "1" }
        ]
      },
      {
        "name": "autoplay",
        "label": "Autoplay first OP",
        "type": "switch",
        "default": "true"
      },
      {
        "name": "playerLocation",
        "label": "Player location",
        "type": "select",
        "default": "button",
        "options": [
          { "label": "Anime page button", "value": "button" },
          { "label": "Tray floating player", "value": "tray" },
          { "label": "Both", "value": "both" }
        ]
      }
    ]
  },
  "isDevelopment": false
}